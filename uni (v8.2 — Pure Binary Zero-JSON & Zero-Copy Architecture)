    @classmethod
    def zero_copy_iter_triplets(cls, raw_view: memoryview):
        """
        Zero-Copy generator: iterates directly over mapped RAM (memoryview)
        without allocating a full list or parsing strings.
        """
        for s_id, p_id, o_id, weight, ego, flags in struct.iter_unpack(cls.TRIPLET_FMT, raw_view):
            yield {
                "s_id64": hex(s_id),
                "p_id64": hex(p_id),
                "o_id64": hex(o_id),
                "weight": round(weight, 4),
                "ego_alignment": round(ego, 4),
                "is_delta_conflict": bool(flags & 1),
            }

    @classmethod
    def merge_binary_graphs_in_ram(cls, view_a: memoryview, view_b: memoryview) -> bytes:
        """
        Hardware-style binary Knowledge Graph Triage (Zone 2):
        Compares 64-bit integer IDs directly in RAM and flags Delta Conflicts
        in superposition without a single string comparison!
        """
        grouped: Dict[Tuple[int, int], List[Tuple[int, float, float]]] = {}
        for view in (view_a, view_b):
            for s_id, p_id, o_id, w, ego, _ in struct.iter_unpack(cls.TRIPLET_FMT, view):
                key = (s_id, p_id)
                grouped.setdefault(key, [])
                if not any(existing[0] == o_id for existing in grouped[key]):
                    grouped[key].append((o_id, w, ego))

        out_buf = bytearray()
        for (s_id, p_id), edges in grouped.items():
            conflict_flag = 1 if len(edges) > 1 else 0
            for o_id, w, ego in edges:
                out_buf.extend(struct.pack(cls.TRIPLET_FMT, s_id, p_id, o_id, w, ego, conflict_flag))
        return bytes(out_buf)

    @classmethod
    def pack_behavior_contract_binary(cls, contract: Dict[str, Any]) -> bytes:
        media_hash = bytes.fromhex(contract.get("media_sha256_hex", "00" * 32))
        return struct.pack(
            cls.CONTRACT_FMT,
            int(contract.get("ttl_sec", 3600)),
            int(contract.get("zone", 1)),
            int(contract.get("hvac_mode", HVACMode.SOLAR_SHIELD_SUMMER)),
            int(contract.get("ui_intent_code", 0x0001)),
            int(contract.get("laser_pulse_cap_mw", 850)),
            media_hash,
        )

    @classmethod
    def unpack_behavior_contract_binary(cls, raw_view: memoryview) -> Dict[str, Any]:
        ttl, zone, hvac, ui_code, mw, m_hash = struct.unpack(cls.CONTRACT_FMT, raw_view)
        return {
            "ttl_sec": ttl,
            "zone": zone,
            "hvac_mode": HVACMode(hvac).name,
            "ui_intent_code": hex(ui_code),
            "laser_pulse_cap_mw": mw,
            "media_sha256_hex": m_hash.hex(),
        }


