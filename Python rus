# 1. ТИПЫ УНИВЕРСАЛЬНЫХ УЗЛОВ И ЗОНЫ ПАМЯТИ (.UNI V 8.0 UNIVERSAL)
# =====================================================================

class UniNodeType(IntEnum):
    NOTARY_ANCHOR     = 0x01  # Цифровой нотариат (Ed25519, полный корень Меркла, дельта-таймлок)
    SEMANTIC_TENSOR   = 0x02  # Векторный эмбеддинг (float32 массив для Zero-Parsing и кластеризации)
    KNOWLEDGE_GRAPH   = 0x03  # Граф знаний (триплеты Субъект-Предикат-Объект + блок Дельт)
    TELEMETRY_MATRIX  = 0x04  # Телеметрия датчиков и медицина (MZM-Pod, биометрия)
    BEHAVIOR_CONTRACT = 0x05  # Смарт-контракт жизни файла (TTL, якоря медиа, теги Хамелеона)
    GENESIS_TEXT      = 0x06  # Человекочитаемый Markdown/UTF-8 слой обратной совместимости


class MemoryZone(IntEnum):
    ZONE_0_SOVEREIGN_VAULT = 0  # Закрытое ядро владельца (ключи, V_0, журнал эволюции)
    ZONE_1_ACTIVE_STREAM   = 1  # Оперативный поток (волатильная память с таймером сброса)
    ZONE_2_SEMANTIC_GRAPH  = 2  # Архив графов и векторов (фоновое сжатие при cosine dist < 0.15)
    ZONE_3_QUARANTINE      = 3  # Песочница / Карантин (для внешних файлов и тревожных подписей Duress)


# =====================================================================
# 2. КРИПТОГРАФИЧЕСКИЕ ПРИМИТИВЫ (HKDF, AES-256-GCM, ED25519)
# =====================================================================

def hkdf_sha256(ikm: bytes, salt: bytes, info: bytes, length: int = 32) -> bytes:
    """Деривация изолированных ключей по стандарту RFC 5869."""
    prk = hmac.new(salt, ikm, hashlib.sha256).digest()
    okm, prev = b"", b""
    for counter in range(1, (length // 32) + 2):
        prev = hmac.new(prk, prev + info + struct.pack("B", counter), hashlib.sha256).digest()
        okm += prev
    return okm[:length]


def aead_encrypt(key: bytes, iv: bytes, plaintext: bytes, aad: bytes) -> Tuple[bytes, bytes]:
    """Аутентифицированное шифрование ноды (AES-256-GCM или резервный контур CTR+HMAC)."""
    if HAS_CRYPTO_LIB:
        ct_tag = AESGCM(key).encrypt(iv, plaintext, aad)
        return ct_tag[:-16], ct_tag[-16:]
    enc_k = hmac.new(key, b"ENC" + iv, hashlib.sha256).digest()
    mac_k = hmac.new(key, b"MAC" + iv, hashlib.sha256).digest()
    ct = bytearray(len(plaintext))
    for i in range(0, len(plaintext), 32):
        ks = hashlib.sha256(enc_k + struct.pack("<I", i // 32)).digest()
        for j, b in enumerate(plaintext[i:i + 32]):
            ct[i + j] = b ^ ks[j]
    tag = hmac.new(mac_k, aad + iv + bytes(ct), hashlib.sha256).digest()[:16]
    return bytes(ct), tag


def aead_decrypt(key: bytes, iv: bytes, ciphertext: bytes, tag: bytes, aad: bytes) -> bytes:
    """Проверка подлинности и расшифровка ноды."""
    if HAS_CRYPTO_LIB:
        return AESGCM(key).decrypt(iv, ciphertext + tag, aad)
    enc_k = hmac.new(key, b"ENC" + iv, hashlib.sha256).digest()
    mac_k = hmac.new(key, b"MAC" + iv, hashlib.sha256).digest()
    exp_tag = hmac.new(mac_k, aad + iv + ciphertext, hashlib.sha256).digest()[:16]
    if not hmac.compare_digest(tag, exp_tag):
        raise ValueError("CRITICAL: Нарушена целостность ноды или заголовка (AEAD Tag Mismatch)!")
    pt = bytearray(len(ciphertext))
    for i in range(0, len(ciphertext), 32):
        ks = hashlib.sha256(enc_k + struct.pack("<I", i // 32)).digest()
        for j, b in enumerate(ciphertext[i:i + 32]):
            pt[i + j] = b ^ ks[j]
    return bytes(pt)


class SovereignKeyring:
    """
    Хранилище ключей Зоны 0 владельца:
    Поддерживает Основной ключ (Primary) и Тревожный ключ под принуждением (Duress Key).
    Оба ключа создают математически валидную подпись для внешних проверяющих!
    """
    def __init__(self, master_seed: bytes):
        self.master_encryption_secret = hkdf_sha256(master_seed, b"ZONE0_SALT", b"MASTER_ENC_SECRET")
        self._primary_priv_seed = hkdf_sha256(master_seed, b"ZONE0_SALT", b"ED25519_PRIMARY")
        self._duress_priv_seed  = hkdf_sha256(master_seed, b"ZONE0_SALT", b"ED25519_DURESS")

        if HAS_CRYPTO_LIB:
            self._primary_sk = Ed25519PrivateKey.from_private_bytes(self._primary_priv_seed)
            self._duress_sk  = Ed25519PrivateKey.from_private_bytes(self._duress_priv_seed)
            self.primary_pubkey = self._primary_sk.public_key().public_bytes_raw()
            self.duress_pubkey  = self._duress_sk.public_key().public_bytes_raw()
        else:
            self.primary_pubkey = hashlib.sha256(b"PUB:" + self._primary_priv_seed).digest()
            self.duress_pubkey  = hashlib.sha256(b"PUB:" + self._duress_priv_seed).digest()

    def sign_data(self, message: bytes, under_duress: bool = False) -> Tuple[bytes, bytes]:
        """Возвращает (публичный_ключ_подписанта_32B, подпись_64B)."""
        if HAS_CRYPTO_LIB:
            sk = self._duress_sk if under_duress else self._primary_sk
            pub = self.duress_pubkey if under_duress else self.primary_pubkey
            return pub, sk.sign(message)
        else:
            priv = self._duress_priv_seed if under_duress else self._primary_priv_seed
            pub = self.duress_pubkey if under_duress else self.primary_pubkey
            sig_p1 = hmac.new(priv, message, hashlib.sha256).digest()
            sig_p2 = hashlib.sha256(pub + message + sig_p1).digest()
            return pub, sig_p1 + sig_p2

    @staticmethod
    def verify_signature(pubkey: bytes, message: bytes, signature: bytes) -> bool:
        """Публичная математическая проверка подписи (проходит и для Primary, и для Duress!)."""
        if len(signature) != 64 or len(pubkey) != 32:
            return False
        if HAS_CRYPTO_LIB:
            try:
                Ed25519PublicKey.from_public_bytes(pubkey).verify(signature, message)
                return True
            except Exception:
                return False
        else:
            exp_p2 = hashlib.sha256(pubkey + message + signature[:32]).digest()
            return hmac.compare_digest(signature[32:], exp_p2)


