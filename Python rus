# 3. БИНАРНАЯ СЕРИАЛИЗАЦИЯ И ВАЛИДАЦИЯ УЗЛОВ (ZERO-EXECUTION TLV)
# =====================================================================

class UniNodePayload:
    """Строгий типизированный упаковщик узлов без исполняемого кода."""

    @staticmethod
    def pack_node(node_type: UniNodeType, data: Any) -> bytes:
        if node_type == UniNodeType.SEMANTIC_TENSOR:
            # Прямая бинарная запись массива float32 (Zero-Parsing)
            floats = [float(x) for x in data]
            return struct.pack(f"<{len(floats)}f", *floats)

        elif node_type == UniNodeType.KNOWLEDGE_GRAPH:
            # Валидация структуры триплетов графа знаний и блока Дельт
            validated_triplets = []
            for item in data:
                validated_triplets.append({
                    "s": str(item["s"]),
                    "p": str(item["p"]),
                    "o": str(item["o"]),
                    "weight": round(float(item.get("weight", 1.0)), 4),
                    "ego_alignment": round(float(item.get("ego_alignment", 0.0)), 4),
                    "solution_link": str(item.get("solution_link", "")),
                    "is_delta_conflict": bool(item.get("is_delta_conflict", False))
                })
            return json.dumps(validated_triplets, ensure_ascii=False, separators=(",", ":")).encode("utf-8")

        elif node_type == UniNodeType.TELEMETRY_MATRIX:
            # Компактная упаковка: список ключей + бинарный буфер IEEE 754 float32
            keys = list(data.keys())
            vals = [float(data[k]) for k in keys]
            keys_header = "|".join(keys).encode("utf-8")
            return struct.pack("<H", len(keys_header)) + keys_header + struct.pack(f"<{len(vals)}f", *vals)

        elif node_type in (UniNodeType.BEHAVIOR_CONTRACT, UniNodeType.NOTARY_ANCHOR):
            return json.dumps(data, ensure_ascii=False, separators=(",", ":")).encode("utf-8")

        elif node_type == UniNodeType.GENESIS_TEXT:
            return str(data).encode("utf-8")

        raise ValueError(f"Неподдерживаемый тип узла: {node_type}")

    @staticmethod
    def unpack_node(node_type: UniNodeType, raw_bytes: bytes) -> Any:
        if node_type == UniNodeType.SEMANTIC_TENSOR:
            count = len(raw_bytes) // 4
            return [round(x, 6) for x in struct.unpack(f"<{count}f", raw_bytes)]

        elif node_type in (UniNodeType.KNOWLEDGE_GRAPH, UniNodeType.BEHAVIOR_CONTRACT, UniNodeType.NOTARY_ANCHOR):
            return json.loads(raw_bytes.decode("utf-8"))

        elif node_type == UniNodeType.TELEMETRY_MATRIX:
            k_len = struct.unpack("<H", raw_bytes[:2])[0]
            keys = raw_bytes[2:2 + k_len].decode("utf-8").split("|")
            floats_buf = raw_bytes[2 + k_len:]
            vals = struct.unpack(f"<{len(keys)}f", floats_buf)
            return {k: round(v, 4) for k, v in zip(keys, vals)}

        elif node_type == UniNodeType.GENESIS_TEXT:
            return raw_bytes.decode("utf-8")

        raise ValueError(f"Неизвестный тип узла при распаковке: {node_type}")


