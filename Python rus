class Zone2SemanticTriage:
    """Фоновое сравнение векторов и слияние графов знаний с выделением конфликтов (Дельт)."""

    @staticmethod
    def cosine_distance(vec_a: List[float], vec_b: List[float]) -> float:
        dot = sum(a * b for a, b in zip(vec_a, vec_b))
        norm_a = math.sqrt(sum(a * a for a in vec_a))
        norm_b = math.sqrt(sum(b * b for b in vec_b))
        if norm_a == 0 or norm_b == 0:
            return 1.0
        return round(1.0 - (dot / (norm_a * norm_b)), 6)

    @classmethod
    def merge_knowledge_graphs(
        cls, graph_a: List[Dict[str, Any]], graph_b: List[Dict[str, Any]]
    ) -> List[Dict[str, Any]]:
        """
        Объединяет два графа знаний: удаляет полные дубли, а при противоречии объектов
        для одного и того же [Субъект + Предикат] помечает обе записи как Узел Суперпозиции (Delta).
        """
        merged: Dict[Tuple[str, str], List[Dict[str, Any]]] = {}
        for item in graph_a + graph_b:
            key = (item["s"], item["p"])
            merged.setdefault(key, [])
            if not any(existing["o"] == item["o"] for existing in merged[key]):
                merged[key].append(dict(item))

        result_graph = []
        for key, items in merged.items():
            is_conflict = len(items) > 1
            for it in items:
                it["is_delta_conflict"] = is_conflict
                result_graph.append(it)
        return result_graph


