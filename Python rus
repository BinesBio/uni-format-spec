# 4. ЯДРО КОНТЕЙНЕРА .UNI (O(1) HEADER, MERKLE TREE, NOTARY, TRIAGE)
# =====================================================================

class UniUniversalContainer:
    """
    Финальная спецификация 32-байтного заголовка UniHeader (Little-Endian '<4sHHIIQ4s4s'):
      00..03 (4B) MAGIC_BYTES  : b'UNI8' (Универсальный стандарт v8.0)
      04..05 (2B) PROTO_FLAGS  : Версия и биты режима
      06..07 (2B) NODE_BITMAP  : Битовая маска присутствующих узлов (до 16 узлов в контейнере)
      08..11 (4B) PAYLOAD_LIMIT: Точный размер полезной нагрузки в байтах (защита от Payload DoS)
      12..15 (4B) SESSION_SALT : 32-битная криптографическая соль сеанса
      16..23 (8B) TIMESTAMP_US : 64-битный счетчик микросекунд (защита от Y2K38 и Replay-атак)
      24..27 (4B) MERKLE_TAG   : Первые 4 байта корня Меркла для быстрой сверки
      28..31 (4B) HEADER_ECC   : 4-байтный код целостности заголовка (O(1) аппаратная проверка)
    """
    HEADER_FMT = "<4sHHIIQ4s4s"
    HEADER_SIZE = 32
    MAGIC = b"UNI8"

    @staticmethod
    def leaf_hash(node_id: int, node_type: int, raw_bytes: bytes) -> bytes:
        return hashlib.sha256(b"UNI8_LEAF:" + struct.pack("<HB", node_id, node_type) + raw_bytes).digest()

    @staticmethod
    def branch_hash(left: bytes, right: bytes) -> bytes:
        return hashlib.sha256(b"UNI8_BRANCH:" + left + right).digest()

    @classmethod
    def build_merkle_tree(
        cls, node_ids: List[int], leaves: List[bytes]
    ) -> Tuple[bytes, Dict[int, List[Dict[str, str]]]]:
        """Возвращает полный 32-байтный корень Меркла и ветки доказательств для каждого узла."""
        if not leaves:
            return b"\x00" * 32, {}
        proofs: Dict[int, List[Dict[str, str]]] = {nid: [] for nid in node_ids}
        positions = {nid: idx for idx, nid in enumerate(node_ids)}
        level = list(leaves)

        while len(level) > 1:
            if len(level) % 2 == 1:
                level.append(level[-1])
            for nid, pos in positions.items():
                sib = level[pos + 1] if pos % 2 == 0 else level[pos - 1]
                side = "right" if pos % 2 == 0 else "left"
                proofs[nid].append({"side": side, "hash": sib.hex()})
                positions[nid] = pos // 2
            level = [cls.branch_hash(level[i], level[i + 1]) for i in range(0, len(level), 2)]

        return level[0], proofs

    @classmethod
    def verify_header_o1(cls, buffer: bytes) -> bool:
        """Мгновенная O(1) валидация 32-байтного заголовка и лимита памяти до распаковки."""
        if len(buffer) < cls.HEADER_SIZE:
            return False
        magic, flags, bitmap, payload_limit, salt, ts_us, m_tag, ecc = struct.unpack(
            cls.HEADER_FMT, buffer[:cls.HEADER_SIZE]
        )
        if magic != cls.MAGIC:
            return False
        if len(buffer) - cls.HEADER_SIZE != payload_limit:
            return False  # Аппаратный сброс при несовпадении размера (Payload DoS Drop)
        expected_ecc = hashlib.blake2s(buffer[:28], digest_size=4).digest()
        return hmac.compare_digest(ecc, expected_ecc)

    @classmethod
    def create_container(
        cls,
        nodes_input: Dict[int, Tuple[UniNodeType, Any]],
        keyring: SovereignKeyring,
        cooling_off_seconds: int = 0,
        under_duress: bool = False
    ) -> bytes:
        """
        Собирает универсальный контейнер .uni, автоматически формируя Нотариальный Узел (Node 0)
        с полной 256-битной корневой хеш-суммой Меркла и подписью Ed25519.
        """
        if 0 in nodes_input:
            raise ValueError("Индекс узла 0 зарезервирован под системный узел NOTARY_ANCHOR")

        session_salt = struct.unpack("<I", os.urandom(4))[0]
        timestamp_us = int(time.time() * 1_000_000)

        # 1. Сериализуем прикладные узлы (1..N) и считаем их хеши для предварительного корня Меркла
        sorted_user_ids = sorted(nodes_input.keys())
        packed_nodes: Dict[int, Tuple[UniNodeType, bytes]] = {}
        user_leaves: List[bytes] = []

        for nid in sorted_user_ids:
            ntype, content = nodes_input[nid]
            raw_b = UniNodePayload.pack_node(ntype, content)
            packed_nodes[nid] = (ntype, raw_b)
            user_leaves.append(cls.leaf_hash(nid, int(ntype), raw_b))

        data_merkle_root, _ = cls.build_merkle_tree(sorted_user_ids, user_leaves)

        # 2. Формируем системный Узел 0 (NOTARY_ANCHOR) — замена бумажного нотариата
        notary_payload_to_sign = (
            data_merkle_root + struct.pack("<QI", timestamp_us, cooling_off_seconds)
        )
        signer_pubkey, signature = keyring.sign_data(notary_payload_to_sign, under_duress=under_duress)

        notary_node_dict = {
            "data_merkle_root_256": data_merkle_root.hex(),
            "signer_pubkey_ed25519": signer_pubkey.hex(),
            "signature_ed25519": signature.hex(),
            "timestamp_us": timestamp_us,
            "cooling_off_delta_t_sec": cooling_off_seconds,
            "status": "PENDING_DELTA_T_CONFIRMATION" if cooling_off_seconds > 0 else "FINALIZED"
        }
        notary_raw_b = UniNodePayload.pack_node(UniNodeType.NOTARY_ANCHOR, notary_node_dict)
        packed_nodes[0] = (UniNodeType.NOTARY_ANCHOR, notary_raw_b)

        # 3. Полное дерево Меркла (включая Узел 0)
        all_ids = [0] + sorted_user_ids
        all_leaves = [cls.leaf_hash(0, int(UniNodeType.NOTARY_ANCHOR), notary_raw_b)] + user_leaves
        full_merkle_root, _ = cls.build_merkle_tree(all_ids, all_leaves)

        # 4. Шифрование каждого узла индивидуальным ключом HKDF + AES-256-GCM
        bitmap = sum(1 << nid for nid in all_ids)
        salt_bytes = struct.pack("<I", session_salt)
        encrypted_chunks: List[bytes] = []

        # Временный заголовок без финального размера для расчета AAD
        for nid in all_ids:
            ntype, raw_b = packed_nodes[nid]
            node_desc = struct.pack("<HBI", nid, int(ntype), len(raw_b))  # 7 байт дескриптора
            iv = hashlib.sha256(salt_bytes + struct.pack("<H", nid) + os.urandom(8)).digest()[:12]
            node_key = hkdf_sha256(keyring.master_encryption_secret, salt_bytes, f"NODE_{nid}".encode())
            ct, tag = aead_encrypt(node_key, iv, raw_b, aad=node_desc)
            encrypted_chunks.append(node_desc + iv + tag + ct)

        payload_blob = b"".join(encrypted_chunks)
        header_28b = struct.pack(
            "<4sHHIIQ4s",
            cls.MAGIC,
            0x0800,
            bitmap,
            len(payload_blob),
            session_salt,
            timestamp_us,
            full_merkle_root[:4]
        )
        ecc = hashlib.blake2s(header_28b, digest_size=4).digest()
        return header_28b + ecc + payload_blob

    @classmethod
    def inspect_and_route(
        cls, uni_binary: bytes, keyring: SovereignKeyring
    ) -> Dict[str, Any]:
        """
        Распаковывает контейнер на стороне доверенного узла, проверяет нотариальную подпись
        и автоматически определяет зону памяти (включая тихий перехват Duress-подписи в Карантин).
        """
        if not cls.verify_header_o1(uni_binary):
            raise ValueError("O(1) Hardware Gate: Заголовок поврежден или нарушен лимит памяти!")

        magic, flags, bitmap, payload_limit, session_salt, ts_us, m_tag, ecc = struct.unpack(
            cls.HEADER_FMT, uni_binary[:cls.HEADER_SIZE]
        )
        salt_bytes = struct.pack("<I", session_salt)

        offset = cls.HEADER_SIZE
        unpacked_nodes: Dict[int, Dict[str, Any]] = {}
        all_ids: List[int] = []
        all_leaves: List[bytes] = []

        while offset < len(uni_binary):
            node_desc = uni_binary[offset:offset + 7]
            nid, ntype_int, raw_len = struct.unpack("<HBI", node_desc)
            iv = uni_binary[offset + 7:offset + 19]
            tag = uni_binary[offset + 19:offset + 35]
            ct = uni_binary[offset + 35:offset + 35 + raw_len]
            offset += 35 + raw_len

            node_key = hkdf_sha256(keyring.master_encryption_secret, salt_bytes, f"NODE_{nid}".encode())
            raw_b = aead_decrypt(node_key, iv, ct, tag, aad=node_desc)
            ntype = UniNodeType(ntype_int)

            all_ids.append(nid)
            all_leaves.append(cls.leaf_hash(nid, ntype_int, raw_b))
            unpacked_nodes[nid] = {
                "type": ntype.name,
                "data": UniNodePayload.unpack_node(ntype, raw_b)
            }

        # Проверка нотариальной подписи в Узле 0
        notary = unpacked_nodes[0]["data"]
        signer_pub = bytes.fromhex(notary["signer_pubkey_ed25519"])
        signature = bytes.fromhex(notary["signature_ed25519"])
        data_root = bytes.fromhex(notary["data_merkle_root_256"])
        delta_t = notary["cooling_off_delta_t_sec"]

        signed_msg = data_root + struct.pack("<QI", notary["timestamp_us"], delta_t)
        is_sig_valid = SovereignKeyring.verify_signature(signer_pub, signed_msg, signature)

        # Стеганографическая проверка на принуждение (Duress Detection)
        if hmac.compare_digest(signer_pub, keyring.duress_pubkey):
            assigned_zone = MemoryZone.ZONE_3_QUARANTINE
            security_verdict = "SILENT_DURESS_ALARM: Файл подписан под принуждением! Изолирован в Зону 3."
        elif not is_sig_valid:
            assigned_zone = MemoryZone.ZONE_3_QUARANTINE
            security_verdict = "INVALID_SIGNATURE: Подпись недействительна."
        else:
            assigned_zone = MemoryZone.ZONE_1_ACTIVE_STREAM
            security_verdict = "VERIFIED_SOVEREIGN: Подпись подлинна (Primary Key)."

        return {
            "public_signature_valid": is_sig_valid,  # Внешний проверяющий всегда видит True!
            "assigned_memory_zone": assigned_zone.name,
            "internal_security_verdict": security_verdict,
            "nodes": unpacked_nodes
        }


