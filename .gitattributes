# ==========================================
# Auto-detect text files and normalize EOL
# ==========================================
* text=auto

# ==========================================
# Source Code (LF line endings)
# ==========================================
*.cpp       text eol=lf diff=cpp
*.hpp       text eol=lf diff=cpp
*.c         text eol=lf diff=cpp
*.h         text eol=lf diff=cpp
*.cc        text eol=lf diff=cpp
*.cxx       text eol=lf diff=cpp
*.py        text eol=lf diff=python
*.sh        text eol=lf

# ==========================================
# Documentation & Markup
# ==========================================
*.md        text eol=lf
*.markdown  text eol=lf
*.tex       text eol=lf
*.bib       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
LICENSE     text eol=lf

# ==========================================
# Windows Specific Scripts
# ==========================================
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# ==========================================
# Binary Files (No EOL conversion / raw diff)
# ==========================================
*.uni       binary
*.bin       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.tar.gz    binary
*.zip       binary
